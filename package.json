{
  "name": "solar-system-emulator",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive 3D Solar System Emulator at solar-system.ajayprakash.dev",
  "author": "Ajay Prakash",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test:science": "node scripts/test-orbital-mechanics.mjs",
    "test:smoke": "node scripts/smoke-production.mjs",
    "test:e2e": "playwright test",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check": "npm run lint && npm run typecheck && npm run test:science && npm run build && npm run test:smoke",
    "repo:branches": "bash scripts/cleanup-repository-branches.sh --dry-run",
    "repo:branches:apply": "bash scripts/cleanup-repository-branches.sh --apply",
    "repo:harden": "bash scripts/harden-repository-settings.sh --dry-run",
    "repo:harden:apply": "bash scripts/harden-repository-settings.sh --apply"
  },
  "dependencies": {
    "@react-three/drei": "^10.4.2",
    "@react-three/fiber": "^9.0.0",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "framer-motion": "^12.23.0",
    "lru-cache": "^11.0.2",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.177.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.177.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.0",
    "postcss": "8.5.30",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  }
}
